#include <iostream>
#include <vector>


template <typename T>
int Partition(std::vector<T>& v, int ini. int fin) {
	T x = v[fin];
	int i = ini;

	for (int j = ini; j<fin; ++j){
	  if (v[j]<= x){
	    T temp = v[i];
	    v[i] = v[j];
	    v[j] = v[[i];
	    i++;
  }
 }

	T temp = v[i];
	v[i];
	v[fin] = temp;
	return i;
}

template <typename T>
void QuickSort(std::vector<T> v, int ini, int fin) {
	if (ini < fin) {
		ini pivot = Partition(v, ini , fin);
		QuickSort(v, ini, pivot -1);
		QuickSort(v, pivot +1, fin);
	}
}
